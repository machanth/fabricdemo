/// Fictional parcel and neighborhood attributes used for assessment analysis.
table DimProperty

	column PropertyKey
		dataType: int64
		isHidden
		sourceColumn: PropertyKey

	column ParcelId
		dataType: string
		sourceColumn: ParcelId

	column NeighborhoodName
		dataType: string
		sourceColumn: NeighborhoodName

	column MarketArea
		dataType: string
		sourceColumn: MarketArea

	column PropertyClassCode
		dataType: string
		sourceColumn: PropertyClassCode

	/// Fabricated address for demonstration only.
	column SyntheticAddress
		dataType: string
		sourceColumn: SyntheticAddress

	partition DimProperty = entity
		mode: directLake
		source
			entityName: dim_property
			schemaName: dbo
			expressionSource: PropertyAssessmentLakehouse
