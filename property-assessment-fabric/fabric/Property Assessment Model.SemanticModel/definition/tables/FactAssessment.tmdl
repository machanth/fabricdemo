/// Certified fictional assessed values by parcel and tax year.
table FactAssessment

	/// Sum of fictional certified assessed values.
	measure 'Total Assessed Value' = SUM(FactAssessment[AssessedValue])
		formatString: $#,0

	measure 'Average Assessment' = AVERAGE(FactAssessment[AssessedValue])
		formatString: $#,0

	/// Illustrative estimate; not legally authoritative.
	measure 'Estimated Tax' = SUM(FactAssessment[EstimatedTax])
		formatString: $#,0

	measure 'Assessment to Sale Ratio' = DIVIDE([Total Assessed Value], [Total Sale Value])
		formatString: 0.00

	column AssessmentId
		dataType: string
		isHidden
		sourceColumn: assessmentId

	column PropertyKey
		dataType: int64
		isHidden
		sourceColumn: propertyKey

	column ValuationDateKey
		dataType: int64
		isHidden
		sourceColumn: valuationDateKey

	column TaxYear
		dataType: int64
		sourceColumn: taxYear

	column AssessedValue
		dataType: double
		isHidden
		sourceColumn: assessedValue

	column EstimatedTax
		dataType: double
		isHidden
		sourceColumn: estimatedTax

	partition FactAssessment = entity
		mode: directLake
		source
			entityName: fact_assessment
			schemaName: dbo
			expressionSource: PropertyAssessmentLakehouse
